	cd /home/jsliang/GPU-DPO/build && $(MAKE) $(MAKESILENT) -f src/psm/src/CMakeFiles/psm_py.dir/build.make src/psm/src/CMakeFiles/psm_py.dir/psm_py-pythonInitVar.cc.s
.PHONY : psm_py-pythonInitVar.cc.s

