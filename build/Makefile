dft_config_lib: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 dft_config_lib
.PHONY : dft_config_lib

# fast build rule for target.
dft_config_lib/fast:
	$(MAKE) $(MAKESILENT) -f src/dft/src/config/CMakeFiles/dft_config_lib.dir/build.make src/dft/src/config/CMakeFiles/dft_config_lib.dir/build
.PHONY : dft_config_lib/fast

